model Auth {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      RoleType @default(USER)

  fullName String
  password String
  email    String @unique

  lastLoginAt     DateTime?
  lastActiveAt    DateTime?

  firebaseUid String?   @unique
  loginType   LoginType @default(EMAIL)

  status          UserStatus @default(ACTIVE)
  isVerified      Boolean    @default(false)
  isOnline        Boolean    @default(false)
  isPhoneVerified Boolean    @default(false)

  otps          OTP[]
  refreshTokens RefreshToken[]

  providerProfile ProviderProfile?

  userProfile UserProfile?


  notifications UserNotification[]


  hostedCalls   Calling[] @relation("HostedCalls")
  receivedCalls Calling[] @relation("ReceivedCalls")


  messages        LiveMessage[]
  chatParticipant LiveChatParticipant[]
  createdChats    LiveChat[]            @relation("LiveChatCreator")
  messageReads    LiveMessageRead[]


  isEmailVerified Boolean @default(false)
}

enum LoginType {
  EMAIL
  GOOGLE
  APPLE
}

enum RoleType {
  USER
  PROVIDER
  ADMIN
}

model RefreshToken {
  id String @id @default(uuid())

  token String @unique

  expiresAt DateTime

  isRevoked Boolean @default(false)

  createdAt DateTime @default(now())

  authId String
  auth   Auth   @relation(fields: [authId], references: [id], onDelete: Cascade)

  @@index([authId])
}

model OTP {
  id        String   @id @default(uuid())
  code      String
  type      OTPType
  expiresAt DateTime

  isUsed    Boolean  @default(false)
  attempt   Int      @default(0)
  createdAt DateTime @default(now())

  authId String
  auth   Auth   @relation(fields: [authId], references: [id], onDelete: Cascade)

  @@index([authId])
  @@index([code])
  @@map("otps")
}

enum OTPType {
  EMAIL_VERIFICATION
  FORGOT_PASSWORD
  LOGIN
}


enum UserStatus {
  ACTIVE
  INACTIVE
  DELETED
  BLOCKED
}
