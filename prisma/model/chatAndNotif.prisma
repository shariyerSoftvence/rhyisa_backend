model Conversation {
  id          String    @id @default(uuid())
  
  // Participants
  participantOneId String
  participantOne   Auth   @relation("ParticipantOne", fields: [participantOneId], references: [id])
  
  participantTwoId String
  participantTwo   Auth   @relation("ParticipantTwo", fields: [participantTwoId], references: [id])

  messages    Message[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([participantOneId, participantTwoId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  text           String       @db.Text
  image          String?
  isRead         Boolean      @default(false)

  // Sender info
  senderId       String
  sender         Auth         @relation("SentMessages", fields: [senderId], references: [id])

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("messages")
}

model Notification {
  id          String           @id @default(uuid())
  title       String
  message     String
  type        NotificationType
  isRead      Boolean          @default(false)
  
  // Target user
  receiverId  String
  receiver    Auth             @relation("UserNotifications", fields: [receiverId], references: [id], onDelete: Cascade)

  referenceId String?          

  createdAt   DateTime         @default(now())

  @@map("notifications")
}

enum NotificationType {
  MESSAGE
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  PAYMENT_SUCCESS
}