model Conversation {
  id String @id @default(uuid())

  // Participants
  participantOneId String
  participantOne   Auth   @relation("ParticipantOne", fields: [participantOneId], references: [id])

  participantTwoId String
  participantTwo   Auth   @relation("ParticipantTwo", fields: [participantTwoId], references: [id])

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([participantOneId, participantTwoId])
  @@map("conversations")
}

model Message {
  id     String  @id @default(uuid())  
  text   String  @db.Text
  image  String?
  isRead Boolean @default(false)

  // Sender info
  senderId String
  sender   Auth   @relation("SentMessages", fields: [senderId], references: [id])

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("messages")
}

model Notification {
  id      String           @id @default(uuid())
  title   String
  message String
  type    NotificationType
  isRead  Boolean          @default(false)

  // Target user
  receiverId String
  receiver   Auth   @relation("UserNotifications", fields: [receiverId], references: [id], onDelete: Cascade)

  referenceId String?

  createdAt DateTime @default(now())

  @@map("notifications")
}

enum NotificationType {
  MESSAGE
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  PAYMENT_SUCCESS
  DATA_ACCESS_REQUEST
  DATA_ACCESS_APPROVED
  DATA_ACCESS_DENIED
}

model VideoCall {
  id              String         @id @default(uuid())
  
  callerId        String
  caller          Auth           @relation("VideoCallsInitiated", fields: [callerId], references: [id])
  
  receiverId      String
  receiver        Auth           @relation("VideoCallsReceived", fields: [receiverId], references: [id])

  status          CallStatus     @default(ONGOING)
  
  // Optional integration fields for third-party (Agora/Twilio)
  channelName     String?
  agoraToken      String?      @db.Text

  startedAt       DateTime       @default(now())
  endedAt         DateTime?
  
  @@map("video_calls")
}

enum CallStatus {
  ONGOING
  COMPLETED
  MISSED
  CANCELLED
}
