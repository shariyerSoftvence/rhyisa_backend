model Media {
  id       String    @id @default(uuid())
  url      String
  key      String?
  fileName String?
  mimeType String?
  size     Int?
  type     MediaType @default(IMAGE)

  // Back relations for ProviderProfile
  providerAsAvatar      ProviderProfile? @relation("ProfileImage")
  ProviderAsGovernmentIssueId      ProviderProfile? @relation("governmentIssueId")
  providerAsLicense     ProviderProfile? @relation("DriverLicense")
  providerAsCertificate  ProviderProfile? @relation("Certificate")
   ProviderAsMarketplaceInsurance   ProviderProfile? @relation("marketplaceInsurance")
  ProviderAsAdditionalCertificate   ProviderProfile? @relation("additionalCertificate")

  // Back relation for UserProfile
  userAsProfileImage UserProfile? @relation("UserProfileImage")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("media")
}

enum MediaType {
  IMAGE
  DOCUMENT
  VIDEO
}
