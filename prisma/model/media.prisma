model Media {
  id           String    @id @default(uuid())
  url          String   
  key          String? 
  fileName     String? 
  mimeType     String?  
  size         Int?      
  type         MediaType @default(IMAGE)

  // Back relations for ProviderProfile
  providerAsAvatar      ProviderProfile? @relation("ProfileImage")
  providerAsLicense     ProviderProfile? @relation("DriverLicense")
  providerAsCertificate ProviderProfile? @relation("Certificate")

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("media")
}

enum MediaType {
  IMAGE
  DOCUMENT
  VIDEO
}