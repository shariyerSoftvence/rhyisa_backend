model ProviderProfile {
  id String @id @default(uuid())

  location    String
  description String @db.Text

  profileImageId String? @unique
  profileImage   Media?  @relation("ProfileImage", fields: [profileImageId], references: [id])

  driverLicenseId String? @unique
  driverLicense   Media?  @relation("DriverLicense", fields: [driverLicenseId], references: [id])

  certificateId String? @unique
  certificate   Media?  @relation("Certificate", fields: [certificateId], references: [id])

  governmentIssueIdUID String? @unique
  governmentIssueId Media?  @relation("governmentIssueId", fields: [governmentIssueIdUID], references: [id])

  marketplaceInsuranceId  String? @unique
  marketplaceInsurance   Media?  @relation("marketplaceInsurance", fields: [marketplaceInsuranceId], references: [id])

  additionalCertificateId   String? @unique
  additionalCertificate    Media?  @relation("additionalCertificate", fields: [additionalCertificateId], references: [id])

  specializationId String?
  specialization   Specialization? @relation(fields: [specializationId], references: [id])

  availabilities ProviderAvailability[]

  services Service[]
  bookings Booking[]
  reviews  Review[]

  stripeAccountId  String? @unique
  isPaymentEnabled Boolean @default(false)


  dataAccessGrants ProviderDataAccess[]

  authId String @unique
  auth   Auth   @relation(fields: [authId], references: [id], onDelete: Cascade)

  status ProviderStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProviderStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Service {
  id                String @id @default(uuid())
  name              String
  price             Float
  durationInMinutes Int

  bookings Booking[]

  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("services")
}

model ProviderAvailability {
  id       String    @id @default(uuid())
  day      DayOfWeek
  fromTime String?
  toTime   String?
  isOff    Boolean   @default(false)

  // Link to Provider
  providerProfileId String
  providerProfile   ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)

  @@unique([providerProfileId, day])
  @@map("provider_availabilities")
}

enum DayOfWeek {
  SATURDAY
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

model Commission {
  id                String          @id @default(uuid())
  commissionType    CommissionType  @default(FLAT)
  commissionRate    Float           @default(20.0)


  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@map("commissions")
}

enum CommissionType {
  FLAT
  PERCENTAGE
}

model ProviderDataAccess {
  id String @id @default(uuid())

  userId String
  user   UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  status DataAccessStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, providerId])
  @@map("provider_data_access")
}

enum DataAccessStatus {
  PENDING
  APPROVED
  DENIED
}
