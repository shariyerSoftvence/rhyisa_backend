model UserProfile {
  id          String  @id @default(uuid())
  fullName    String
  phoneNumber String?
  address     String?

  // Health Profile Fields
  age              Int?
  height           Float?
  weight           Float?
  bodyType         BodyType?
  averageFatLevel  FatLevelRange?
  healthConditions HealthCondition[]
  shortTermGoal    ShortTermGoal?
  longTermGoal     LongTermGoal?
  mealDescription  String

  bodyPhotoId String? @unique
  bodyPhoto   Media?  @relation("UserBodyPhoto", fields: [bodyPhotoId], references: [id])

  // Subscription & Payment
  subscriptionType SubscriptionType @default(FREE)
  stripeCustomerId String?          @unique

  // Relations
  authId String @unique
  auth   Auth   @relation(fields: [authId], references: [id], onDelete: Cascade)

  healthLogs       UserDailyHealthLog[]
  dataAccessGrants ProviderDataAccess[]

  bookings Booking[]
  reviews  Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserDailyHealthLog {
  id   String   @id @default(uuid())
  date DateTime @default(now())

  steps        Int @default(0)
  stepsGoal    Int @default(6000)
  sleepHours   Int
  sleepMinutes Int

  mood MoodType?

  energyLevel Int @default(1)
  energyGoal  Int @default(5)

  stressLevel StressType?

  hungerLevel HungerType?

  cravings String?

  // Metrics with Goals
  calories    Int @default(0)
  calorieGoal Int @default(2000)

  waterGlasses Int @default(0)
  waterGoal    Int @default(8)

  proteinGrams Int @default(0)
  proteinGoal  Int @default(120)

  carbsGrams Int @default(0)
  carbsGoal  Int @default(250)

  fatGrams Int @default(0)
  fatGoal  Int @default(65)

  // Overall Score
  healthScore Int @default(0)

  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@unique([userProfileId, date])
  @@index([userProfileId])
  @@map("daily_health_logs")
}

enum MoodType {
  STEADY
  HAPPY
  SAD
  ANXIOUS
  IRRITABLE
}

enum StressType {
  LOW
  MODERATE
  HIGH
}

enum HungerType {
  LOW
  MODERATE
  HIGH
}

enum BodyType {
  ECTOMORPH
  MESOMORPH
  ENDOMORPH
  OTHER
}


enum FatLevelRange {
  ESSENTIAL 
  ATHLETE
  FITNESS 
  ACCEPTABLE 
  HIGH
  OBESE 
}


enum HealthCondition {
  NONE
  DIABETES_TYPE_1
  DIABETES_TYPE_2
  HYPERTENSION   
  HYPOTENSION  
  CARDIOVASCULAR  
  ASTHMA_RESPIRATORY 
  PREGNANCY
  POST_PARTUM  
  ARTHRITIS_JOINT_PAIN
  KIDNEY_DISEASE
  THYROID_DISORDER
  CHRONIC_FATIGUE 
}

enum SubscriptionType {
  FREE
  PREMIUM
}


enum ShortTermGoal {
  LOSE_WEIGHT_QUICKLY  
  KICKSTART_METABOLISM 
  DETOX_CLEANSE 
  ADAPT_HEALTHY_EATING  
  IMPROVE_DAILY_HYDRATION 
  STAMINA_BOOST_WEEKLY 
  REDUCE_SUGAR_CRAVING 
}

enum LongTermGoal {
  SUSTAINABLE_WEIGHT_LOSS 
  MUSCLE_HYPERTROPHY  
  REVERSE_DIABETES_PREDIABETES 
  CARDIOVASCULAR_ENDURANCE 
  ANTI_AGING_LONGEVITY      
  STRESS_MANAGEMENT_MENTAL_CLARITY 
  HOLISTIC_LIFESTYLE_TRANSFORMATION
}