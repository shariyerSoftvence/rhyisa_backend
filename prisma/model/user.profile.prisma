model UserProfile {
  id          String  @id @default(uuid())
  fullName    String
  phoneNumber String?
  address     String?

  // Health Profile Fields
  age              Int?
  height           Float?
  weight           Float?
  bodyType         BodyType?
  averageFatLevel  Float?
  healthConditions String?
  shortTermGoal    String?
  longTermGoal     String?

  bodyPhotoId String? @unique
  bodyPhoto   Media?  @relation("UserBodyPhoto", fields: [bodyPhotoId], references: [id])

  // Subscription & Payment
  subscriptionType SubscriptionType @default(FREE)
  stripeCustomerId String?          @unique

  // Relations
  authId String @unique
  auth   Auth   @relation(fields: [authId], references: [id], onDelete: Cascade)

  healthLogs       UserDailyHealthLog[]
  dataAccessGrants ProviderDataAccess[]

  bookings Booking[]
  reviews  Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserDailyHealthLog {
  id   String   @id @default(uuid())
  date DateTime @default(now())

  steps        Int @default(0)
  stepsGoal    Int @default(6000)
  sleepHours   Int
  sleepMinutes Int

  mood MoodType?

  energyLevel Int @default(1)
  energyGoal  Int @default(5)

  stressLevel StressType?

  hungerLevel HungerType?

  cravings String?

  // Metrics with Goals
  calories    Int @default(0)
  calorieGoal Int @default(2000)

  waterGlasses Int @default(0)
  waterGoal    Int @default(8)

  proteinGrams Int @default(0)
  proteinGoal  Int @default(120)

  carbsGrams Int @default(0)
  carbsGoal  Int @default(250)

  fatGrams Int @default(0)
  fatGoal  Int @default(65)

  // Overall Score
  healthScore Int @default(0)

  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@unique([userProfileId, date])
  @@index([userProfileId])
  @@map("daily_health_logs")
}

enum MoodType {
  STEADY
  HAPPY
  SAD
  ANXIOUS
  IRRITABLE
}

enum StressType {
  LOW
  MODERATE
  HIGH
}

enum HungerType {
  LOW
  MODERATE
  HIGH
}

enum BodyType {
  ECTOMORPH
  MESOMORPH
  ENDOMORPH
  OTHER
}

enum SubscriptionType {
  FREE
  PREMIUM
}
