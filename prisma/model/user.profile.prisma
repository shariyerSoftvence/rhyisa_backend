enum CurrentActivityLevel {
  SEDENTARY 
  LIGHT_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  EXTREMELY_ACTIVE
}
enum CurrentDiet {
  STANDARD_DIET
  BALANCED
  HIGH_PROTEIN
  LOW_CARD
  PLAN_BASED
}
enum PrimaryGoal {
  LOSE_WEIGHT
  BUILD_MUSCLE
  IMPROVE_HEALTH
  IMPROVE_OVERALL_HEALTH
  BETTER_SLEEP
  MANAGE_STRESS
  OTHERS
}

enum SupplementType {
  NONE
  MULTIVITAMIN
  PROTEIN_SUPPLEMENT
  CREATINE
  OMEGA_3
}
model UserProfile {
  id          String  @id @default(uuid())
  fullName    String
  phoneNumber String?
  address     String?

  // Health Profile Fields
  age              Int?
  gender         Gender?
  height           Float?
  weight           Float?

  currentActivityLevel   CurrentActivityLevel?
  currentDiet            CurrentDiet?
  primaryGoal            PrimaryGoal[] @default([])

  motivationLevel Int?
  hasHealthCondition Boolean @default(false)
  supplements SupplementType[] @default([])

  // bodyType         BodyType?
  // averageFatLevel  FatLevelRange?
  // healthConditions HealthCondition[]
  // shortTermGoal    ShortTermGoal?
  // longTermGoal     LongTermGoal?
  // mealDescription  String

  profileImageId String? @unique
  profileImage   Media?  @relation("UserProfileImage", fields: [profileImageId], references: [id])

  // Subscription & Payment
  subscriptionType SubscriptionType @default(FREE)
  stripeCustomerId String?          @unique

  // Relations
  authId String @unique
  auth   Auth   @relation(fields: [authId], references: [id], onDelete: Cascade)

  healthGoal UserHealthGoal?

   healthLogs UserDailyHealthLog[]
  dataAccessGrants ProviderDataAccess[]

  bookings Booking[]
  reviews  Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


enum Gender {
  MALE
  FEMALE
  PREFER_NOT_TO_SAY
}



model UserHealthGoal {
  id String @id @default(uuid())

  calorieGoal Int @default(2000)

  waterGoal Int @default(8)

  proteinGoal Int @default(120)

  carbsGoal Int @default(250)

  fatGoal Int @default(65)

  stepsGoal Int @default(6000)

  sleepGoalHours Int @default(8)

  generatedByAI Boolean @default(true)

  userProfileId String @unique

  userProfile UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_health_goals")
}

model UserDailyHealthLog {
  id String @id @default(uuid())

  date DateTime @default(now())

  /**
   * Daily Tracking Values
   */

  calories Int @default(0)

  waterGlasses Int @default(0)

  proteinGrams Int @default(0)

  carbsGrams Int @default(0)

  fatGrams Int @default(0)

  steps Int @default(0)

  sleepHours Int @default(0)

  sleepMinutes Int @default(0)

  mood MoodType?

  energyLevel Int @default(1)

  stressLevel StressType?

  hungerLevel HungerType?

  cravings String?

  /**
   * Daily Score
   */

  healthScore Int @default(0)

  /**
   * Relation
   */

  userProfileId String

  userProfile UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userProfileId, date])

  @@index([userProfileId])

  @@map("daily_health_logs")
}
enum MoodType {
  STEADY
  HAPPY
  SAD
  ANXIOUS
  IRRITABLE
}

enum StressType {
  LOW
  MODERATE
  HIGH
}

enum HungerType {
  LOW
  MODERATE
  HIGH
}

